# Copy this file to .env and fill it in. NEVER commit .env (it's in .gitignore).

NODE_ENV=development
PORT=3000

# Frontend address(es) allowed to call the API, comma-separated. VS Code Live Server uses port 5500.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
# Set to true only when deployed behind a proxy (Render, Railway, Nginx).
TRUST_PROXY=false

# Postgres connection string from Supabase or Neon, e.g.
#   postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Only for `npm test`: a SEPARATE, empty database (for example a second free Neon/Supabase project).
# The tests ERASE all data in it before running. Never use the real DATABASE_URL here.
TEST_DATABASE_URL=

# Long random secret that signs login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Only emails on these domains (and their subdomains, e.g. gbox.adnu.edu.ph) can sign up.
ALLOWED_EMAIL_DOMAINS=adnu.edu.ph

# First admin account, created at startup (password: 12+ characters).
SEED_ADMIN_EMAIL=admin@adnu.edu.ph
SEED_ADMIN_PASSWORD=

# Email notifications (leave SMTP_HOST empty to print emails to console for free during development)
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# SMS notifications (default provider is 'console'; other options: 'twilio', 'android-gateway')
SMS_PROVIDER=console
SMS_API_URL=
SMS_API_KEY=
SMS_FROM=
