{
  "name": "astik-gatepass-backend",
  "version": "0.1.0",
  "private": true,
  "description": "REST API for Astik Gate Pass, the AdNU Campus Sticker Car Parking System",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
